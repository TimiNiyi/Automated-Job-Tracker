        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\":{\n    \"job_title\":{\n      \"type\":[\"string\", \"null\"],\n      \"description\": \"The job title associated with the application. Use an empty string if unknown\"\n    },\n    \"company\":{\n      \"type\":[\"string\", \"null\"],\n      \"description\": \"The employer or company name mentioned in the email. Use an empty string if unknown\"\n  },\n    \"application_status\":{\n      \"type\": [\"string\", \"null\"],\n      \"enum\":[\n        \"Applied\",\n        \"Interviewed\",\n        \"First stage interview\",\n        \"Second stage interview\",\n        \"Third stage interview\",\n        \"Orientation\",\n        \"Rejected\",\n        \"Assessment\",\n        \"Offer\",\n        \"Unknown\"\n      ],\n      \"description\": \"The application stage explicitly supported in the email. Use email if stage is undetermined\"\n},\n  \"job_type\":{\n    \"type\":[\"string\", \"null\"],\n    \"enum\":[\n        \"Internship\",\n        \"Fulltime\",\n        \"Part time\",\n        \"contract\"\n      ],\n    \"description\": \"The type of job explicitly supported in the email\"\n},\n  \"notes\":{\n      \"type\":[\"string\", \"null\"],\n      \"description\": \"Important things that are mentioned in the email to note. For example, interview date and time\"\n  },\n    \"interview_date\":{\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Interview date explicitly stated in the email, if available. Return the date in YYYY-MM-DD format. If no interview date is explicitly stated, return null.\"\n  },\n    \"interview_time\":{\n      \"type\":[\"string\", \"null\"],\n      \"description\":\"Interview time explicitly stated in the email, if available. Return the time in HOUR-MINUTE format. If no interview time is explicitly stated, return null.\"\n    }\n}\n}",
