    {
      "parameters": {
        "text": "={{ \"subject :\" + $json.subject + \"\\n\\n snippet:\" + $json.snippet + \"\\n\\n from:\" + $json.From + \"\\n\\n\\n messageId:\" + $json.id + \"\\n\\n processedAt:\" + $json.internalDate}}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"job_title\":{\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"The job title associated with the application. Use an empty string if unknown\"\n  },\n    \"company\":{\n      \"type\":[\"string\", \"null\"],\n      \"description\": \"The employer or company name mentioned in the email. Use an empty string if unknown.\"\n  },\n    \"application_status\":{\n      \"type\":[\"string\", \"null\"],\n      \"enum\": [\n        \"Applied\",\n        \"Interviewed\",\n        \"Assessment\",\n        \"Offer\",\n        \"second stage interview\",\n        \"third stage interview\",\n        \"Rejected\",\n        \"Unknown\"\n      ],\n      \"description\": \"The application stage explicitly supported in the email. Use email if stage is undetermined\"\n  },\n    \"job_type\":{\n      \"type\":[\"string\", \"null\"],\n      \"enum\": [\n        \"internship\",\n        \"fulltime\",\n        \"part-time\",\n        \"contract\"\n      ],\n      \"description\": \"The type of job explicitly supported in the email\"\n  },\n    \"notes\":{\n      \"type\":[\"string\", \"null\"],\n      \"description\": \"Important things that are mentioned in the email to note. For example, interview date and time\"\n  },\n    \"interview_date\":{\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Interview date explicitly stated in the email, if available. Return the date in YYYY-MM-DD format. If no interview date is explicitly stated, return null.\"\n  },\n    \"interview_time\":{\n      \"type\":[\"string\", \"null\"],\n      \"description\":\"Interview time explicitly stated in the email, if available. Return the time in HOUR-MINUTE format. If no interview time is explicitly stated, return null.\"\n    },\n    \"email_Id\":{\n      \"type\":[\"string\", \"null\"],\n      \"description\":\"Email address of the sender explicitly available in the email metadata, if available. Return null if unavailable.\"\n    },\n    \"email_Date\":{\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Date the email was received, explicitly available in the email metadata. Return the date in YYYY-MM-DD format, or null if unavailable.\"\n  },\n    \"last_updated\":{\n      \"type\":[\"number\", \"null\"]\n  }\n}\n}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
